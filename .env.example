# Copy this file to .env and fill in real values.
# The pipeline runs fully without an API key (using the built-in mock
# extractor), so this is only needed once you want real LLM extraction.

# --- LLM (Step 2: Fund Analyst Agent) ---
# If unset, the pipeline automatically falls back to the deterministic
# mock extractor so the demo still runs end to end.
ANTHROPIC_API_KEY=
# Verify this against https://docs.claude.com/en/docs/about-claude/models
# for the model currently available on your account.
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Storage ---
DATABASE_URL=sqlite:///storage/app.db
VECTOR_DB_PATH=storage/vector_db
UPLOAD_DIR=storage/uploaded_pdfs

# --- Pipeline behavior ---
# Fields with LLM confidence >= this are auto-approved; below go to
# the human review queue.
CONFIDENCE_THRESHOLD=0.75
SME_EMAIL=test@test.com
